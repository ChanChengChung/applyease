APP_ENV=development
DATABASE_URL=postgresql+psycopg://applyease:applyease@localhost:5433/applyease
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_EXTRACTION_ENABLED=false
AI_JOB_ANALYSIS_ENABLED=false
AI_MATERIAL_GENERATION_ENABLED=false
AI_APPLICATION_FORM_ENABLED=false
SCREENSHOT_OCR_ENABLED=false
MAX_SCREENSHOT_BYTES=5242880
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional Alibaba Cloud Model Studio provider. For a workspace-scoped Key,
# copy the exact "OpenAI compatible" Base URL from the API Key page.
# To use it: LLM_PROVIDER=dashscope (optionally LLM_FALLBACK_PROVIDER=ollama).
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_MAX_REQUESTS_PER_MINUTE=10
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
GEMINI_MAX_REQUESTS_PER_MINUTE=10
# Used only by Opportunity Radar's server-side guided web research. Create a
# token in Brave Search API dashboard; never expose it in VITE_ variables.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_TIMEOUT_SECONDS=10
BRAVE_SEARCH_MAX_REQUESTS=3
# Preferred domestic provider for Opportunity Radar. Keep the API key only on
# the server, never in a VITE_ variable.
BOCHA_SEARCH_API_KEY=
BOCHA_SEARCH_TIMEOUT_SECONDS=10
BOCHA_SEARCH_MAX_REQUESTS=3
# Short server-side cache for official Greenhouse job-board indexes.
OFFICIAL_JOB_FEED_CACHE_SECONDS=300
LLM_MAX_PROMPT_CHARACTERS=40000
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=86400
AUTH_COOKIE_NAME=applyease_session
AUTH_CSRF_COOKIE_NAME=applyease_csrf
AUTH_COOKIE_SECURE=false
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_MAX_FAILED_IP_ATTEMPTS=25
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_REQUIRE_VERIFIED_EMAIL=false
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
ACCOUNT_EMAIL_MAX_REQUESTS=3
ACCOUNT_EMAIL_MAX_IP_REQUESTS=20
ACCOUNT_EMAIL_RATE_LIMIT_WINDOW_SECONDS=3600
ACCOUNT_TOKEN_MAX_FAILED_ATTEMPTS=20
FRONTEND_BASE_URL=http://127.0.0.1:5173
# file writes development messages to backend/dev-mailbox; production must use smtp.
MAIL_DELIVERY_MODE=file
MAIL_FILE_DIR=./dev-mailbox
MAIL_FROM=ApplyEase <no-reply@applyease.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ENFORCE_HTTPS=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Set true for account login UI; local development defaults to the legacy local-user compatibility mode.
VITE_AUTH_REQUIRED=false
