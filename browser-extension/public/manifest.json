{
  "manifest_version": 3,
  "name": "ApplyEase Field Preview",
  "version": "0.1.0",
  "description": "Preview and fill user-approved application form answers from ApplyEase.",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {"default_title": "ApplyEase", "default_popup": "popup.html"},
  "background": {"service_worker": "src/background.js", "type": "module"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle"}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
