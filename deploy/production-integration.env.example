# Test-only settings for scripts/verify-production-stack.sh.
# Never deploy this file or reuse its values. APP_DOMAIN=localhost makes Caddy
# issue an internal local certificate, so the test has no DNS/SMTP dependency.
APP_DOMAIN=localhost
APP_VERSION=integration-check-2026-08-20
POSTGRES_USER=applyease_check
POSTGRES_PASSWORD=check-only-postgres-password-2026
POSTGRES_DB=applyease
AUTH_SECRET=check-only-auth-secret-must-not-be-used-outside-local-integration
MAIL_FROM=ApplyEase Check <no-reply@localhost>
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_USERNAME=check-user
SMTP_PASSWORD=check-only-smtp-password
SMTP_STARTTLS=true
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:4b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_EXTRACTION_ENABLED=false
AI_JOB_ANALYSIS_ENABLED=false
AI_MATERIAL_GENERATION_ENABLED=false
AI_APPLICATION_FORM_ENABLED=false
SCREENSHOT_OCR_ENABLED=false
JOB_IMPORT_MAX_REQUESTS=20
JOB_IMPORT_RATE_LIMIT_WINDOW_SECONDS=3600
AI_GENERATION_MAX_REQUESTS=30
AI_GENERATION_RATE_LIMIT_WINDOW_SECONDS=900
CLOUD_OCR_MAX_REQUESTS=10
CLOUD_OCR_RATE_LIMIT_WINDOW_SECONDS=3600
