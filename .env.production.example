# Copy to .env.production on the server. Never commit the copied file.
# APP_DOMAIN must already have public DNS A/AAAA records pointing to the server.
APP_DOMAIN=applyease.example.com
# Use an immutable Git tag or commit, e.g. v1.0.0 or 4e3a1d2. This is exposed
# by /health/ready so an operator can verify the actual running release.
APP_VERSION=replace-with-immutable-release-tag

POSTGRES_USER=applyease_prod
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=applyease

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters

MAIL_FROM=ApplyEase <no-reply@applyease.example.com>
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password-or-app-password
SMTP_STARTTLS=true

# Use a remote Ollama endpoint reachable from the server, or leave blank to
# allow Gemini + deterministic fallbacks. Do not point this at a Mac-only URL.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:4b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

AI_EXTRACTION_ENABLED=true
AI_JOB_ANALYSIS_ENABLED=true
AI_MATERIAL_GENERATION_ENABLED=true
AI_APPLICATION_FORM_ENABLED=true
# Gemini OCR sends a user-consented image to Gemini. Enable only after filling
# GEMINI_API_KEY; production startup otherwise rejects this combination.
SCREENSHOT_OCR_ENABLED=false
JOB_IMPORT_MAX_REQUESTS=20
JOB_IMPORT_RATE_LIMIT_WINDOW_SECONDS=3600

# Per-account provider budgets. Keep OCR lower because each accepted image is
# sent to Gemini after explicit consent. Both counters persist in PostgreSQL.
AI_GENERATION_MAX_REQUESTS=30
AI_GENERATION_RATE_LIMIT_WINDOW_SECONDS=900
CLOUD_OCR_MAX_REQUESTS=10
CLOUD_OCR_RATE_LIMIT_WINDOW_SECONDS=3600
